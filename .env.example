# Enterprise-Hermes — secrets + deployment scaffold (NEVER commit real values)
# Copy to .env and fill in real values on the target host.

# --- LLM (general agent engine) ---
# Point at an IN-NETWORK OpenAI-compatible endpoint for zero egress; or set one
# up and provide a key. Uses OpenRouter-compatible API by default.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash-0731
# LLM_API_KEY=                      # <-- your provider key
ALLOW_EGRESS=false                  # false = safe default (models resolve in-network only)

# --- HTTP ---
PORT=8080

# --- Enterprise SSO (prod) ---
# PROD: replace demo tokens with real OIDC/SAML in core/auth.py. Tokens here are
# per-org demo identities for the bundled sandbox and MUST be rotated.